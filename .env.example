# Copy to .env and fill in. .env is gitignored — never commit real keys.

# Static key the iPhone Shortcut sends as the X-API-Key header. Only used while ALLOW_LEGACY_API_KEY is on.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=change-me

# Temporary single-owner fallback. Off by default. When on, X-API-Key acts as the user below.
# Every other request must carry a Supabase access token: Authorization: Bearer <token>.
# ALLOW_LEGACY_API_KEY=false
# LEGACY_USER_ID=<the owner's auth.users id, a UUID>  (required when ALLOW_LEGACY_API_KEY is on)

# Supabase project: Settings -> API. Use the service_role key (server-side only).
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

ANTHROPIC_API_KEY=sk-ant-...

# Optional overrides.
CLAUDE_MODEL=claude-sonnet-4-5
# Fallback used when the primary's reply fails validation. Check both model IDs against
# Anthropic's model docs before deploying; an ID that does not exist fails at the first scan.
CLAUDE_FALLBACK_MODEL=claude-sonnet-5-5
RECEIPTS_BUCKET=receipts
MAX_UPLOAD_BYTES=10485760
